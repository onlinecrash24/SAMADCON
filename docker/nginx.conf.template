# SAMADCON — nginx front end.
#
# Serves the React bundle, terminates TLS and proxies /api to uvicorn. Runs
# unprivileged, so every writable path points somewhere the samadcon user owns.

worker_processes auto;
daemon off;
pid /run/samadcon/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;

    client_body_temp_path /run/samadcon/nginx-client;
    proxy_temp_path       /run/samadcon/nginx-proxy;
    fastcgi_temp_path     /run/samadcon/nginx-fastcgi;
    uwsgi_temp_path       /run/samadcon/nginx-uwsgi;
    scgi_temp_path        /run/samadcon/nginx-scgi;

    access_log          /var/log/nginx/access.log;
    sendfile            on;
    tcp_nopush          on;
    keepalive_timeout   65;
    server_tokens       off;

    # Which hop in front of us may be believed about the caller's address.
    # Written by the entrypoint from SAMADCON_TRUSTED_PROXIES; empty unless a
    # deployment names one, because an unconfigured proxy list means every
    # X-Forwarded-For is a claim from a stranger. In the http block so both
    # servers inherit it.
    include ${SAMADCON_CONF_DIR}/real-ip.conf;

    # ADMX bundles are the largest thing a user uploads.
    client_max_body_size 64m;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_types        text/plain text/css application/json application/javascript
                      application/xml text/xml image/svg+xml;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ------------------------------------------------------------------
    # Plain HTTP: redirects to HTTPS, except the health endpoint which the
    # container health check hits locally.
    # ------------------------------------------------------------------
    server {
        listen 8080 default_server;
        listen [::]:8080 default_server;

        location = /api/v1/health {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            access_log off;
        }

        location / {
            return 301 ${REDIRECT_TARGET};
        }
    }

    # ------------------------------------------------------------------
    # HTTPS
    # ------------------------------------------------------------------
    server {
        listen 8443 ssl default_server;
        listen [::]:8443 ssl default_server;
        http2 on;

        # Filled in by the entrypoint: it falls back to a writable directory
        # when the configured one is not writable for this user.
        ssl_certificate     ${SAMADCON_TLS_CERT};
        ssl_certificate_key ${SAMADCON_TLS_KEY};
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers off;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1h;
        ssl_session_tickets off;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "DENY" always;
        add_header Referrer-Policy           "no-referrer" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

        location /api/ {
            proxy_pass         http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            # One address, already resolved: $remote_addr is the caller
            # after real_ip has walked whatever chain a trusted proxy sent.
            # Appending to the inbound header instead would hand uvicorn a list
            # whose ends mean different things — and the audit log would record
            # whichever end it happened to pick.
            proxy_set_header   X-Forwarded-For   $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        $connection_upgrade;

            # Directory searches over slow WAN links to a DC can take a while.
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_buffering    off;
        }

        # Hashed assets are immutable, index.html never is.
        location /assets/ {
            root      /srv/samadcon/www;
            expires   1y;
            add_header Cache-Control "public, immutable";
        }

        location / {
            root      /srv/samadcon/www;
            try_files $uri $uri/ /index.html;
            add_header Cache-Control "no-cache";
        }
    }
}
