# SAMADCON — the settings of the deployment stack.
#
# Copy this file to `.env` beside docker-compose.yml and change what you need:
#
#   cp .env.example .env
#
# Anything left out keeps the default written in the compose file, which is the
# value that file used to state outright — so an untouched .env changes nothing.
#
# **In Portainer there is no .env.** Type these same names into the stack's
# environment fields, or use "Load variables from .env file" to upload this one.
# The compose file is not touched either way, which is the point of it.
#
# **No password belongs here.** The console does not read one from the
# environment: it asks whoever signs in, and uses their own AD account.

# The name the console is reached under. It becomes the CN and the SAN of the
# self-signed certificate, so a wrong value here is a certificate warning for
# everyone. The one value practically every installation must change.
SAMADCON_PUBLIC_HOST=samadcon.example.lan

# The port people reach. Only the HTTP-to-HTTPS redirect uses it. Behind a
# reverse proxy this is the proxy's port — 443 — not the one published below.
SAMADCON_PUBLIC_HTTPS_PORT=8443

# The port the host publishes. Usually the same as the line above; different
# only behind a proxy.
SAMADCON_HTTPS_PORT=8443

# The Kerberos realm, upper case. May stay empty: the sign-in form then asks
# for a server address and works the domain out from it.
SAMADCON_REALM=EXAMPLE.LAN

# The domain controller. An IP is fine — its own name is read from the rootDSE.
SAMADCON_DC_HOSTS=192.168.1.1

# INFO names what happens; DEBUG is for tracking a problem down.
SAMADCON_LOG_LEVEL=INFO

# The reverse proxy in front of the container, if there is one: its host's
# address, so the audit log records the administrator and not the proxy.
# Empty means no proxy — the address that connected is the one recorded.
# Never 0.0.0.0/0: that trusts every host and fills the audit log with claims.
SAMADCON_TRUSTED_PROXIES=

# A resolver that serves the domain, for finding a DC through SRV records.
# Not needed when SAMADCON_DC_HOSTS names the controllers directly. To use it,
# uncomment these and the dns: block in the compose file.
#SAMADCON_DNS=192.168.1.1
#SAMADCON_DNS_SEARCH=example.lan
